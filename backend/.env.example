DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://hospitalcare:hospitalcare@localhost:5432/hospitalcare
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
SESSION_IDLE_MINUTES=30
# A critical emergency case unfulfilled this long in its current status is escalated automatically (a whole number, 1 or more).
EMERGENCY_ESCALATION_MINUTES=30
# Candidate scoring (story #40). JSON keyed by resource type: blood, bed, equipment or operatingRoom. Anything not set keeps its default.
# Strategies: earliestExpiry (blood default), nearest (other types' default) and mostStock. Weights are relative, and a bad value stops the server.
MATCHING_SCORING={"blood":{"strategy":"earliestExpiry","weights":{"expiry":0.6,"distance":0.4}},"bed":{"strategy":"mostStock"}}
# The distance in km at which the distance factor reaches 0 (a whole number, 1 or more).
MATCHING_MAX_DISTANCE_KM=50
# Minutes a reserved resource is held for a case before it is released to stock (a whole number, 1 or more).
RESERVATION_HOLD_MINUTES=30
